+    // Storia start - faster entity pushing (identical results)
+    /**
+     * Same result as {@code level().getPushableEntities(this, getBoundingBox())} for everything
+     * {@link #pushEntities()} reads, but cheaper when many entities are crammed together:
+     * <ul>
+     * <li>this entity's own pushability is checked once (the vanilla predicate re-checks it per candidate;
+     *     pushEntities already returned if it is false);</li>
+     * <li>each candidate's {@code isPushable()} is evaluated once instead of twice (it is idempotent);</li>
+     * <li>empty collidable-exemption sets skip the UUID hash lookup;</li>
+     * <li>collection stops adding once pushEntities has everything it will use: the first
+     *     {@code max(1, pushesAvailable)} entities (list order is unchanged, so the pushed entities are the
+     *     same, and the list is non-empty exactly when vanilla's is) and, when cramming is enabled, at least
+     *     {@code maxCramming} non-passengers (so the cramming size check, its random roll and the damage
+     *     decision all come out the same).</li>
+     * </ul>
+     * {@code isPushable()} is still called on every candidate, as vanilla does, because {@code onClimbable()}
+     * records the climbable position as a side effect.
+     */
+    private static final boolean STORIA_VERIFY_PUSH = Boolean.getBoolean("storia.verifyPush");
+    private static final java.util.concurrent.atomic.AtomicLong STORIA_PUSH_CHECKS = new java.util.concurrent.atomic.AtomicLong();
+    private static final java.util.concurrent.atomic.AtomicLong STORIA_PUSH_MISMATCHES = new java.util.concurrent.atomic.AtomicLong();
+
+    /** Debug (-Dstoria.verifyPush=true): compares the fast collection with vanilla's on live data. */
+    private void storia$verifyPushable(final List<Entity> fast, final int maxCramming, final int pushesAvailable) {
+        final List<Entity> vanilla = this.level().getPushableEntities(this, this.getBoundingBox());
+        boolean same = fast.isEmpty() == vanilla.isEmpty() && fast.size() <= vanilla.size()
+            && vanilla.subList(0, fast.size()).equals(fast)
+            && fast.size() >= Math.min(vanilla.size(), pushesAvailable);
+        if (maxCramming > 0) {
+            same &= (fast.size() > maxCramming - 1) == (vanilla.size() > maxCramming - 1);
+            same &= (fast.stream().filter(e -> !e.isPassenger()).count() > maxCramming - 1)
+                == (vanilla.stream().filter(e -> !e.isPassenger()).count() > maxCramming - 1);
+        }
+        final long checks = STORIA_PUSH_CHECKS.incrementAndGet();
+        if (!same) {
+            STORIA_PUSH_MISMATCHES.incrementAndGet();
+        }
+        if (checks % 100000 == 0) {
+            LOGGER.info("[Storia] push verify: {} checks, {} mismatches", checks, STORIA_PUSH_MISMATCHES.get());
+        }
+    }
+
+    private List<Entity> storia$getPushableEntities(final int maxCramming, final int pushesAvailable) {
+        final net.minecraft.world.scores.Team ownTeam = this.getTeam();
+        final net.minecraft.world.scores.Team.CollisionRule ownCollisionRule = ownTeam == null ? net.minecraft.world.scores.Team.CollisionRule.ALWAYS : ownTeam.getCollisionRule();
+        final UUID selfId = this.getUUID();
+        final boolean selfCollides = this.collides;
+        final Set<UUID> selfExemptions = this.collidableExemptions;
+        final int needed = Math.max(1, pushesAvailable);
+        final int[] counts = new int[2]; // [0] collected, [1] collected non-passengers
+        final boolean[] full = new boolean[1];
+        return this.level().getEntities(this, this.getBoundingBox(), (final Entity input) -> {
+            if (input.isSpectator() || !input.isPushable()) {
+                return false;
+            }
+            if (full[0]) {
+                return false;
+            }
+            // input.canCollideWithBukkit(this); input.isPushable() is known to be true
+            if (input instanceof LivingEntity living
+                && living.collides == (!living.collidableExemptions.isEmpty() && living.collidableExemptions.contains(selfId))) {
+                return false;
+            }
+            // this.canCollideWithBukkit(input); this.isPushable() is known to be true
+            if (selfCollides == (!selfExemptions.isEmpty() && selfExemptions.contains(input.getUUID()))) {
+                return false;
+            }
+            if (!(!this.level().isClientSide() || input instanceof Player player && player.isLocalPlayer())) {
+                return false;
+            }
+            final net.minecraft.world.scores.Team theirTeam = input.getTeam();
+            final net.minecraft.world.scores.Team.CollisionRule theirCollisionRule = theirTeam == null ? net.minecraft.world.scores.Team.CollisionRule.ALWAYS : theirTeam.getCollisionRule();
+            if (theirCollisionRule == net.minecraft.world.scores.Team.CollisionRule.NEVER || (input instanceof Player && !io.papermc.paper.configuration.GlobalConfiguration.get().collisions.enablePlayerCollisions)) {
+                return false;
+            }
+            final boolean sameTeam = ownTeam != null && ownTeam.isAlliedTo(theirTeam);
+            if (!((ownCollisionRule != net.minecraft.world.scores.Team.CollisionRule.PUSH_OWN_TEAM && theirCollisionRule != net.minecraft.world.scores.Team.CollisionRule.PUSH_OWN_TEAM || !sameTeam)
+                && (ownCollisionRule != net.minecraft.world.scores.Team.CollisionRule.PUSH_OTHER_TEAMS && theirCollisionRule != net.minecraft.world.scores.Team.CollisionRule.PUSH_OTHER_TEAMS || sameTeam))) {
+                return false;
+            }
+            counts[0]++;
+            if (!input.isPassenger()) {
+                counts[1]++;
+            }
+            if (counts[0] >= needed && (maxCramming <= 0 || counts[1] >= maxCramming)) {
+                full[0] = true;
+            }
+            return true;
+        });
+    }
+    // Storia end - faster entity pushing (identical results)
+
     protected void checkAutoSpinAttack(final AABB old, final AABB current) {
         AABB minmax = old.minmax(current);
         List<Entity> entities = this.level().getEntities(this, minmax);
