Subject: [PATCH] Stolia worldgen optimizations

- Count block states without building per-state coordinate lists
- Faster ImprovedNoise/PerlinNoise sampling with bit-identical output

diff --git a/net/minecraft/util/SimpleBitStorage.java b/net/minecraft/util/SimpleBitStorage.java
index 85cf4ad3dc290b41c8463258189999bcc35d2d08..26ae98449d334fb10c273d1397e2578e129d114a 100644
--- a/net/minecraft/util/SimpleBitStorage.java
+++ b/net/minecraft/util/SimpleBitStorage.java
@@ -400,6 +400,50 @@ public class SimpleBitStorage implements BitStorage {
     }
 
     // Paper start - block counting
+    // Stolia start - count block states without building per-state coordinate lists
+    /** Counts occurrences of each palette id; the result has length {@code 1 << bits}. Only for {@code bits <= 8}. */
+    public final int[] stolia$countIds() {
+        final int valuesPerLong = this.valuesPerLong;
+        final int bits = this.bits;
+        final long mask = (1L << bits) - 1L;
+        final int size = this.size;
+        final int[] counts = new int[1 << bits];
+
+        int index = 0;
+        for (long value : this.data) {
+            int li = 0;
+            do {
+                ++counts[(int)(value & mask)];
+                value >>= bits;
+                ++li;
+                ++index;
+            } while (li < valuesPerLong && index < size);
+        }
+        return counts;
+    }
+
+    /** Adds, in index order, every index whose palette id is flagged in {@code wanted}. */
+    public final void stolia$collectIndices(final boolean[] wanted, final ca.spottedleaf.moonrise.common.list.ShortList out) {
+        final int valuesPerLong = this.valuesPerLong;
+        final int bits = this.bits;
+        final long mask = (1L << bits) - 1L;
+        final int size = this.size;
+
+        int index = 0;
+        for (long value : this.data) {
+            int li = 0;
+            do {
+                if (wanted[(int)(value & mask)]) {
+                    out.add((short)index);
+                }
+                value >>= bits;
+                ++li;
+                ++index;
+            } while (li < valuesPerLong && index < size);
+        }
+    }
+    // Stolia end - count block states without building per-state coordinate lists
+
     @Override
     public final it.unimi.dsi.fastutil.ints.Int2ObjectOpenHashMap<it.unimi.dsi.fastutil.shorts.ShortArrayList> moonrise$countEntries() {
         final int valuesPerLong = this.valuesPerLong;
diff --git a/net/minecraft/world/level/chunk/LevelChunkSection.java b/net/minecraft/world/level/chunk/LevelChunkSection.java
index 705f6314d2550b0f1c8c5209dd65161d89cbfd7e..6e7dd8180703814517a5e98613d82463ed3c7012 100644
