+++ b/net/minecraft/world/level/chunk/LevelChunkSection.java
@@ -206,6 +206,47 @@ public class LevelChunkSection implements ca.spottedleaf.moonrise.patches.block_
             final int paletteSize = palette.getSize();
             final net.minecraft.util.BitStorage storage = data.storage();
 
+            // Stolia start - count block states without building per-state coordinate lists
+            // Coordinates are only needed for randomly ticking states, so count first and collect those in a second pass.
+            if (paletteSize != 1 && storage instanceof net.minecraft.util.SimpleBitStorage simpleStorage && simpleStorage.getBits() <= 8) {
+                final int[] stateCounts = simpleStorage.stolia$countIds();
+                boolean[] ticking = null;
+                for (int paletteIdx = 0; paletteIdx < stateCounts.length; ++paletteIdx) {
+                    final int paletteCount = stateCounts[paletteIdx];
+                    if (paletteCount == 0) {
+                        continue;
+                    }
+                    final BlockState state = palette.valueFor(paletteIdx);
+                    if (state.isAir()) {
+                        continue;
+                    }
+                    if (ca.spottedleaf.moonrise.patches.collisions.CollisionUtil.isSpecialCollidingBlock(state)) {
+                        this.specialCollidingBlocks += (short)paletteCount;
+                    }
+                    this.nonEmptyBlockCount += (short)paletteCount;
+                    if (state.isRandomlyTicking()) {
+                        this.tickingBlockCount += (short)paletteCount;
+                        if (ticking == null) {
+                            ticking = new boolean[stateCounts.length];
+                        }
+                        ticking[paletteIdx] = true;
+                    }
+                    final FluidState fluid = state.getFluidState();
+                    if (!fluid.isEmpty()) {
+                        this.fluidCount += (short)paletteCount;
+                        if (fluid.isRandomlyTicking()) {
+                            this.tickingFluidCount += (short)paletteCount;
+                        }
+                    }
+                }
+                if (ticking != null) {
+                    this.tickingBlocks.setMinCapacity(Math.min(this.tickingBlockCount * 3 / 2, 16 * 16 * 16));
+                    simpleStorage.stolia$collectIndices(ticking, this.tickingBlocks);
+                }
+                return;
+            }
+            // Stolia end - count block states without building per-state coordinate lists
+
