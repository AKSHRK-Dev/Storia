From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AKSHRK-Dev <311836316+AKSHRK-Dev@users.noreply.github.com>
Date: Sun, 27 Sep 2026 01:59:23 +0900
Subject: [PATCH] Storia cluster: share the scoreboard between nodes


diff --git a/net/minecraft/server/ServerScoreboard.java b/net/minecraft/server/ServerScoreboard.java
index 3c1d3c873e857a16ed33dcd77ab937017256776c..54180b75ef57d2248fae66b8abc76d1dd777ca1a 100644
--- a/net/minecraft/server/ServerScoreboard.java
+++ b/net/minecraft/server/ServerScoreboard.java
@@ -50,6 +50,7 @@ public class ServerScoreboard extends Scoreboard {
     @Override
     protected void onScoreChanged(final ScoreHolder owner, final Objective objective, final Score score) {
         super.onScoreChanged(owner, objective, score);
+        dev.storia.cluster.ClusterScoreboard.score(this, owner, objective, score); // Storia - cluster
         if (this.trackedObjectives.contains(objective)) {
             this.broadcastAll( // CraftBukkit
                     new ClientboundSetScorePacket(
@@ -68,12 +69,14 @@ public class ServerScoreboard extends Scoreboard {
     @Override
     protected void onScoreLockChanged(final ScoreHolder owner, final Objective objective) {
         super.onScoreLockChanged(owner, objective);
+        dev.storia.cluster.ClusterScoreboard.scoreLock(this, owner, objective); // Storia - cluster
         this.setDirty();
     }
 
     @Override
     public void onPlayerRemoved(final ScoreHolder player) {
         super.onPlayerRemoved(player);
+        dev.storia.cluster.ClusterScoreboard.scoreReset(this, player, null); // Storia - cluster
         if (!this.trackedObjectives.isEmpty()) {
             this.broadcastAll(new ClientboundResetScorePacket(player.getScoreboardName(), null)); // CraftBukkit
         }
@@ -84,6 +87,7 @@ public class ServerScoreboard extends Scoreboard {
     @Override
     public void onPlayerScoreRemoved(final ScoreHolder player, final Objective objective) {
         super.onPlayerScoreRemoved(player, objective);
+        dev.storia.cluster.ClusterScoreboard.scoreReset(this, player, objective); // Storia - cluster
         if (this.trackedObjectives.contains(objective)) {
             this.broadcastAll(new ClientboundResetScorePacket(player.getScoreboardName(), objective.getName())); // CraftBukkit
         }
@@ -95,6 +99,7 @@ public class ServerScoreboard extends Scoreboard {
     public void setDisplayObjective(final DisplaySlot slot, final @Nullable Objective objective) {
         Objective old = this.getDisplayObjective(slot);
         super.setDisplayObjective(slot, objective);
+        dev.storia.cluster.ClusterScoreboard.display(this, slot, objective); // Storia - cluster
         if (old != objective && old != null) {
             if (this.getObjectiveDisplaySlotCount(old) > 0) {
                 this.broadcastAll(new ClientboundSetDisplayObjectivePacket(slot, objective)); // CraftBukkit
@@ -117,6 +122,7 @@ public class ServerScoreboard extends Scoreboard {
     @Override
     public boolean addPlayerToTeam(final String player, final PlayerTeam team) {
         if (super.addPlayerToTeam(player, team)) {
+            dev.storia.cluster.ClusterScoreboard.members(this, team, java.util.List.of(player), true); // Storia - cluster
             this.broadcastAll(ClientboundSetPlayerTeamPacket.createPlayerPacket(team, player, ClientboundSetPlayerTeamPacket.Action.ADD)); // CraftBukkit
             this.updatePlayerWaypoint(player);
             this.setDirty();
@@ -136,6 +142,7 @@ public class ServerScoreboard extends Scoreboard {
         }
 
         if (anyAdded) {
+            dev.storia.cluster.ClusterScoreboard.members(this, team, players, true); // Storia - cluster
             this.broadcastAll(ClientboundSetPlayerTeamPacket.createMultiplePlayerPacket(team, players, ClientboundSetPlayerTeamPacket.Action.ADD));
             this.setDirty();
             return true;
@@ -148,6 +155,7 @@ public class ServerScoreboard extends Scoreboard {
     @Override
     public void removePlayerFromTeam(final String player, final PlayerTeam team) {
         super.removePlayerFromTeam(player, team);
+        dev.storia.cluster.ClusterScoreboard.members(this, team, java.util.List.of(player), false); // Storia - cluster
         this.broadcastAll(ClientboundSetPlayerTeamPacket.createPlayerPacket(team, player, ClientboundSetPlayerTeamPacket.Action.REMOVE)); // CraftBukkit
         this.updatePlayerWaypoint(player);
         this.setDirty();
@@ -158,6 +166,7 @@ public class ServerScoreboard extends Scoreboard {
         for (String playerName : players) {
             super.removePlayerFromTeam(playerName, team);
         }
+        dev.storia.cluster.ClusterScoreboard.members(this, team, players, false); // Storia - cluster
 
         this.broadcastAll(ClientboundSetPlayerTeamPacket.createMultiplePlayerPacket(team, players, ClientboundSetPlayerTeamPacket.Action.REMOVE));
         this.setDirty();
@@ -167,12 +176,14 @@ public class ServerScoreboard extends Scoreboard {
     @Override
     public void onObjectiveAdded(final Objective objective) {
         super.onObjectiveAdded(objective);
+        dev.storia.cluster.ClusterScoreboard.objective(this, objective); // Storia - cluster
         this.setDirty();
     }
 
     @Override
     public void onObjectiveChanged(final Objective objective) {
         super.onObjectiveChanged(objective);
+        dev.storia.cluster.ClusterScoreboard.objective(this, objective); // Storia - cluster
         if (this.trackedObjectives.contains(objective)) {
             this.broadcastAll(new ClientboundSetObjectivePacket(objective, ClientboundSetObjectivePacket.METHOD_CHANGE)); // CraftBukkit
         }
@@ -183,6 +194,7 @@ public class ServerScoreboard extends Scoreboard {
     @Override
     public void onObjectiveRemoved(final Objective objective) {
         super.onObjectiveRemoved(objective);
+        dev.storia.cluster.ClusterScoreboard.objectiveRemoved(this, objective); // Storia - cluster
         if (this.trackedObjectives.contains(objective)) {
             this.stopTrackingObjective(objective);
         }
@@ -193,6 +205,7 @@ public class ServerScoreboard extends Scoreboard {
     @Override
     public void onTeamAdded(final PlayerTeam team) {
         super.onTeamAdded(team);
+        dev.storia.cluster.ClusterScoreboard.team(this, team); // Storia - cluster
         this.broadcastAll(ClientboundSetPlayerTeamPacket.createAddOrModifyPacket(team, true)); // CraftBukkit
         this.setDirty();
     }
@@ -200,6 +213,7 @@ public class ServerScoreboard extends Scoreboard {
     @Override
     public void onTeamChanged(final PlayerTeam team) {
         super.onTeamChanged(team);
+        dev.storia.cluster.ClusterScoreboard.team(this, team); // Storia - cluster
         this.broadcastAll(ClientboundSetPlayerTeamPacket.createAddOrModifyPacket(team, false)); // CraftBukkit
         this.updateTeamWaypoints(team);
         this.setDirty();
@@ -208,6 +222,7 @@ public class ServerScoreboard extends Scoreboard {
     @Override
     public void onTeamRemoved(final PlayerTeam team) {
         super.onTeamRemoved(team);
+        dev.storia.cluster.ClusterScoreboard.teamRemoved(this, team); // Storia - cluster
         this.broadcastAll(ClientboundSetPlayerTeamPacket.createRemovePacket(team)); // CraftBukkit
         this.updateTeamWaypoints(team);
         this.setDirty();
