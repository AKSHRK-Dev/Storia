diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkUpgradeGenericStatusTask.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkUpgradeGenericStatusTask.java
index 78fd90e0aa4d84ab13de8c101c5d31596e9ba1f7..58c49d4c680683e260c2320006740baf5eb3599a 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkUpgradeGenericStatusTask.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkUpgradeGenericStatusTask.java
@@ -130,6 +130,23 @@ public final class ChunkUpgradeGenericStatusTask extends ChunkProgressionTask im
             return;
         }
 
+        // Stolia start - offload: complete later instead of blocking a worker thread on a remote result.
+        // Only for parallel-capable statuses, which hold no area lock, so finishing from another task is safe.
+        if (generation && !completeFuture.isDone() && ((ChunkSystemChunkStatus)this.toStatus).moonrise$isParallelCapable()) {
+            // this task has already run, so its own priority is no longer a queueable one
+            final Priority current = this.getPriority();
+            final Priority priority = Priority.isValidPriority(current) ? current : Priority.NORMAL;
+            completeFuture.whenComplete((final ChunkAccess result, final Throwable throwable) -> {
+                try {
+                    this.scheduler.parallelGenExecutor.createTask(() -> this.stolia$finish(result, throwable), priority).queue();
+                } catch (final Throwable queueFailure) {
+                    this.stolia$finish(result, throwable);
+                }
+            });
+            return;
+        }
+        // Stolia end - offload
+
         if (!completeFuture.isDone() && !((ChunkSystemChunkStatus)this.toStatus).moonrise$getWarnedAboutNoImmediateComplete().getAndSet(true)) {
             LOGGER.warn("Future status not complete after scheduling: " + this.toStatus.toString() + ", generate: " + generation);
         }
@@ -156,6 +173,18 @@ public final class ChunkUpgradeGenericStatusTask extends ChunkProgressionTask im
         this.complete(newChunk, null);
     }
 
+    // Stolia start - offload
+    private void stolia$finish(final ChunkAccess newChunk, final Throwable throwable) {
+        if (throwable != null) {
+            this.complete(null, throwable);
+        } else if (newChunk == null) {
+            this.complete(null, new IllegalStateException("Chunk for status: " + this.toStatus + " should not be null!").fillInStackTrace());
+        } else {
+            this.complete(newChunk, null);
+        }
+    }
+    // Stolia end - offload
+
     private volatile boolean scheduled;
     private static final VarHandle SCHEDULED_HANDLE = ConcurrentUtil.getVarHandle(ChunkUpgradeGenericStatusTask.class, "scheduled", boolean.class);
 
