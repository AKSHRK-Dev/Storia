diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index eb8ab385c220526bae54663089229e5b2a234984..865c62a7cae2d1ff05fb616773263e7870f3ee66 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1196,6 +1196,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.halt(wait, false);
     }
     public void halt(final boolean wait, final boolean isRestarting) {
+        if (!wait && dev.storia.cluster.Cluster.drainThenHalt(() -> this.halt(false, isRestarting))) return; // Storia - cluster: hand players to other nodes before stopping
         this.isRestarting = isRestarting;
         this.hasLoggedStop = true; // Paper - Debugging
         if (this.isDebugging()) io.papermc.paper.util.TraceUtil.dumpTraceForThread("Server stopped"); // Paper - Debugging
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 27af2db32ac2e01346beb9a722760f5da3aa4e13..218e1bcd3907879a99597ed796a1ca532daca89e 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -2493,6 +2493,15 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     }
 
     public MapId getFreeMapId() {
+        // Storia start - cluster: map ids are handed out by the coordinator, so two nodes never make the same map id
+        if (dev.storia.cluster.Cluster.enabled()) {
+            try {
+                return new MapId(dev.storia.cluster.Cluster.nextMapId());
+            } catch (final java.io.IOException ex) {
+                throw new IllegalStateException("Cannot get a map id from the cluster coordinator", ex);
+            }
+        }
+        // Storia end - cluster
         return this.getServer().getDataStorage().computeIfAbsent(MapIndex.TYPE).getNextMapId();
     }
 
