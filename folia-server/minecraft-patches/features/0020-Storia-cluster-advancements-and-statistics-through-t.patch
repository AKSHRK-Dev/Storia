diff --git a/net/minecraft/server/PlayerAdvancements.java b/net/minecraft/server/PlayerAdvancements.java
index d447b444abd9b62ab241419301a96d19ae77a7eb..0ba5814af897b075f12f08eba69d1120afca2093 100644
--- a/net/minecraft/server/PlayerAdvancements.java
+++ b/net/minecraft/server/PlayerAdvancements.java
@@ -110,6 +110,23 @@ public class PlayerAdvancements {
     }
 
     private void load(final ServerAdvancementManager manager) {
+        // Storia start - cluster: advancements live on the coordinator
+        if (dev.storia.cluster.Cluster.enabled()) {
+            try {
+                final byte[] bytes = dev.storia.cluster.Cluster.readPlayer(this.player.getStringUUID(), "advancements");
+                if (bytes != null) {
+                    JsonElement json = StrictJsonParser.parse(new java.io.StringReader(new String(bytes, StandardCharsets.UTF_8)));
+                    PlayerAdvancements.Data data = this.codec.parse(JsonOps.INSTANCE, json).getOrThrow(JsonParseException::new);
+                    this.applyFrom(manager, data);
+                }
+            } catch (IOException | JsonParseException e) {
+                LOGGER.error("Couldn't load player advancements for {} from the cluster", this.player.getStringUUID(), e);
+            }
+            this.checkForAutomaticTriggers(manager);
+            this.registerListeners(manager);
+            return;
+        }
+        // Storia end - cluster
         if (Files.isRegularFile(this.playerSavePath)) {
             try (Reader reader = Files.newBufferedReader(this.playerSavePath, StandardCharsets.UTF_8)) {
                 JsonElement json = StrictJsonParser.parse(reader);
@@ -129,6 +146,18 @@ public class PlayerAdvancements {
     public void save() {
         if (org.spigotmc.SpigotConfig.disableAdvancementSaving) return; // Spigot
         JsonElement json = this.codec.encodeStart(JsonOps.INSTANCE, this.asData()).getOrThrow();
+        // Storia start - cluster
+        if (dev.storia.cluster.Cluster.enabled()) {
+            try {
+                final java.io.StringWriter out = new java.io.StringWriter();
+                GSON.toJson(json, GSON.newJsonWriter(out));
+                dev.storia.cluster.Cluster.writePlayer(this.player.getStringUUID(), "advancements", out.toString().getBytes(StandardCharsets.UTF_8));
+            } catch (IOException | JsonIOException e) {
+                LOGGER.error("Couldn't save player advancements for {} to the cluster", this.player.getStringUUID(), e);
+            }
+            return;
+        }
+        // Storia end - cluster
 
         try {
             FileUtil.createDirectoriesSafe(this.playerSavePath.getParent());
