diff --git a/net/minecraft/world/level/storage/SavedDataStorage.java b/net/minecraft/world/level/storage/SavedDataStorage.java
index 74b055c34aba4d52b1d55965015ba2eface0dc4a..e0976b6d005815019020bc8ad3fd15373112229d 100644
--- a/net/minecraft/world/level/storage/SavedDataStorage.java
+++ b/net/minecraft/world/level/storage/SavedDataStorage.java
@@ -121,9 +121,29 @@ public class SavedDataStorage implements AutoCloseable {
         // Folia end - region threading
     }
 
+    // Storia start - cluster: shared data files (maps, command storage) live on the coordinator
+    private @Nullable String storia$shared(final Path file) {
+        final Path world = this.dataFolder.toAbsolutePath().normalize().getParent();
+        if (world == null) return null;
+        final String relative = world.relativize(file.toAbsolutePath().normalize()).toString().replace('\\', '/');
+        return dev.storia.cluster.Cluster.sharesData(relative) ? relative : null;
+    }
+    // Storia end - cluster
+
     private <T extends SavedData> @Nullable T readSavedData(final SavedDataType<T> type) {
         try {
             Path file = this.getDataFile(type.id());
+            // Storia start - cluster
+            final String shared = this.storia$shared(file);
+            if (shared != null) {
+                final byte[] bytes = dev.storia.cluster.Cluster.readData(shared);
+                if (bytes == null) return null;
+                CompoundTag tag = NbtIo.readCompressed(new java.io.ByteArrayInputStream(bytes), NbtAccounter.unlimitedHeap());
+                tag = type.dataFixType().update(this.fixerUpper, tag, NbtUtils.getDataVersion(tag, 1343), SharedConstants.getCurrentVersion().dataVersion().version());
+                RegistryOps<Tag> ops = this.registries.createSerializationContext(NbtOps.INSTANCE);
+                return type.codec().parse(ops, tag.get("data")).resultOrPartial(error -> LOGGER.error("Failed to parse saved data for '{}': {}", type, error)).orElse(null);
+            }
+            // Storia end - cluster
             if (Files.exists(file)) {
                 CompoundTag tag = this.readTagFromDisk(file, type.dataFixType(), SharedConstants.getCurrentVersion().dataVersion().version());
                 RegistryOps<Tag> ops = this.registries.createSerializationContext(NbtOps.INSTANCE);
@@ -282,6 +302,19 @@ public class SavedDataStorage implements AutoCloseable {
 
     private void tryWrite(final SavedDataType<?> type, final CompoundTag tag) {
         Path path = this.getDataFile(type.id());
+        // Storia start - cluster
+        final String shared = this.storia$shared(path);
+        if (shared != null) {
+            try {
+                final java.io.ByteArrayOutputStream bytes = new java.io.ByteArrayOutputStream();
+                NbtIo.writeCompressed(tag, (java.io.OutputStream) bytes);
+                dev.storia.cluster.Cluster.writeData(shared, bytes.toByteArray());
+            } catch (IOException e) {
+                LOGGER.error("Could not save {} to the cluster", shared, e);
+            }
+            return;
+        }
+        // Storia end - cluster
 
         try {
             FileUtil.createDirectoriesSafe(path.getParent());
