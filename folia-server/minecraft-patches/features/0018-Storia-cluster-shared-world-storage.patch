     private Optional<CompoundTag> load(final NameAndId nameAndId, final String suffix) {
+        // Storia start - cluster: player data lives on the coordinator
+        if (dev.storia.cluster.Cluster.enabled()) {
+            if (!suffix.equals(".dat")) return Optional.empty();
+            try {
+                return Optional.ofNullable(dev.storia.cluster.Cluster.readPlayerTag(nameAndId.id().toString()));
+            } catch (final java.io.IOException ex) {
+                // never let them in with empty data: the next save would overwrite their real data
+                LOGGER.warn("Failed to load player data for {} from the cluster", nameAndId.name(), ex);
+                throw new IllegalStateException("Could not load the player data of " + nameAndId.name() + " from the Storia Cluster coordinator; try again in a moment", ex);
+            }
+        }
+        // Storia end - cluster
         File realFile = new File(this.playerDir, nameAndId.id() + suffix);
